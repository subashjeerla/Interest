def make_time_series_windows(series, lookback, start_target, end_target):
    """
    Each sample uses the previous `lookback` values to predict series[t].
    Target indices are in [start_target, end_target).
    """
    X, y = [], []
    for t in range(start_target, end_target):
        X.append(series[t - lookback:t])
        y.append(series[t])
    X = np.asarray(X, dtype=np.float32)[..., np.newaxis]
    y = np.asarray(y, dtype=np.float32)
    return X, y


